# ════════════════════════════════════════════
#  Naukri Bot — Environment Configuration
# ════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── Naukri Credentials ──────────────────────
NAUKRI_EMAIL=your@email.com
NAUKRI_PASSWORD=yourpassword

# ── Gemini API (FREE tier) ──────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 req/min, 1 million tokens/day — plenty for job applying!
GEMINI_API_KEY=AIzaSy...

# ── Your Profile (used by LLM to answer Qs) ─
PROFILE_NAME=Your Full Name
PROFILE_CURRENT_ROLE=Software Engineer
PROFILE_EXPERIENCE_YEARS=3
PROFILE_SKILLS=Python, JavaScript, React, Node.js
PROFILE_CURRENT_CTC=10 LPA
PROFILE_EXPECTED_CTC=15 LPA
PROFILE_NOTICE_PERIOD=30 days
PROFILE_CURRENT_LOCATION=Bangalore
PROFILE_PREFERRED_LOCATION=Bangalore, Hyderabad, Remote
PROFILE_CURRENT_COMPANY=ABC Corp
PROFILE_QUALIFICATION=B.Tech Computer Science

# ── Google Sheets ────────────────────────────
# See README.md → "Google Sheets Setup" for step-by-step instructions
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
GOOGLE_SPREADSHEET_ID=1ABC...xyz          # From the sheet URL
GOOGLE_SHEET_NAME=Sheet1
